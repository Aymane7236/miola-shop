apiVersion: v1
kind: Secret
metadata:
  name: groq-secret
type: Opaque
data:
  # ============================================================
  # TEMPLATE - Renommez ce fichier en 03-groq-secret.yaml
  # et remplacez la valeur ci-dessous par votre cle Groq encodee en base64.
  #
  # 1. Obtenir une cle Groq gratuite : https://console.groq.com/keys
  # 2. Encoder en base64 :
  #    Windows (PowerShell) :
  #      [Convert]::ToBase64String([Text.Encoding]::UTF8.GetBytes("gsk_VotreCle..."))
  #    Linux/Mac :
  #      echo -n "gsk_VotreCle..." | base64
  # 3. Coller le resultat dans api-key ci-dessous
  # ============================================================
  api-key: PLACEHOLDER_REPLACE_WITH_YOUR_BASE64_KEY